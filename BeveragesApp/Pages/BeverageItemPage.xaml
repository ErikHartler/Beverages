<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageItemPage">

    <VerticalStackLayout VerticalOptions="Center">
            <Label Text="Dryck"
            SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Headline}"            
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>
        <HorizontalStackLayout>
            <Entry x:Name="BeverageIdEntry" Placeholder="Dryckens ID"  IsEnabled="False"  WidthRequest="70" />
            <Entry x:Name="BeverageNameEntry" Placeholder="Dryckens namn"   WidthRequest="70"  />
            <Entry x:Name="BeverageDescriptionEntry" Placeholder="Dryckens beskrivning"   WidthRequest="70"  />
            <Entry x:Name="BeveragePriceEntry" Placeholder="Dryckens pris"   WidthRequest="70" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Picker Title="Välj dryckeskategori" x:Name="CategoryPicker"
                    ItemDisplayBinding="{Binding Name}" WidthRequest="70" />

            <Picker Title="Välj ursprungsland" x:Name="CountryPicker"
                ItemDisplayBinding="{Binding Name}" WidthRequest="70" />

            <Picker Title="Betygsätt" x:Name="RemarkPicker"
                ItemDisplayBinding="{Binding Name}" WidthRequest="70" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Image x:Name="CapturedPhotoImage" WidthRequest="300" HeightRequest="150" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Button Text="Ta foto" Clicked="OnCapturePhotoClicked" WidthRequest="140" />
            <Button Grid.Column="2" Text="Spara" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" WidthRequest="100" />
            <Button Grid.Column="3" Text="Ta bort" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" WidthRequest="100" />
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentPage>
