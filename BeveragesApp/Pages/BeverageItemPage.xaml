<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageItemPage">

    <VerticalStackLayout Spacing="5" Padding="5,0" VerticalOptions="Center">
            <Label Text="Dryck"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>
        <Entry x:Name="BeverageIdEntry" Placeholder="Dryckens ID"  IsEnabled="False"  />
        <Entry x:Name="BeverageNameEntry" Placeholder="Dryckens namn"   />
        <Entry x:Name="BeverageDescriptionEntry" Placeholder="Dryckens beskrivning"   />
        <Entry x:Name="BeveragePriceEntry" Placeholder="Dryckens pris"   />


        <Picker Title="Välj dryckeskategori" x:Name="CategoryPicker"
            ItemDisplayBinding="{Binding Name}" />

        <Picker Title="Välj ursprungsland" x:Name="CountryPicker"
            ItemDisplayBinding="{Binding Name}" />

        <Picker Title="Betygsätt" x:Name="RemarkPicker"
            ItemDisplayBinding="{Binding Name}" />
        
        <Button Text="Ta foto" Clicked="OnCapturePhotoClicked" />
        <Image x:Name="CapturedPhotoImage" WidthRequest="300" HeightRequest="150" />
        
        <Button Grid.Column="2" Text="Uppdatera" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" />
            <Button Grid.Column="3" Text="Ta bort" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" />
        </VerticalStackLayout>

</ContentPage>
