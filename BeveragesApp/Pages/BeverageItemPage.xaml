<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageItemPage">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
    <VerticalStackLayout>
            <HorizontalStackLayout>
                <ImageButton Source="back.png" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" />
            </HorizontalStackLayout>
            <Label Text="Dryck"
            SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Headline}"            
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>

            <Grid ColumnDefinitions="*,2*,*,2*,*,2*" ColumnSpacing="8" HorizontalOptions="Fill">
                <Label Text="ID" Grid.Column="0" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="End"/>
                <Entry Grid.Column="1" x:Name="BeverageIdEntry" Placeholder="Dryckens ID" IsEnabled="False" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>

                <Label Text="Namn" Grid.Column="2" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="End"/>
                <Entry Grid.Column="3" x:Name="BeverageNameEntry" Placeholder="Dryckens namn" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>

                <Label Text="Pris" Grid.Column="4" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="End"/>
                <Entry Grid.Column="5" x:Name="BeveragePriceEntry" Placeholder="Dryckens pris" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3" HorizontalOptions="Fill">

                    <Picker Title="Välj dryckeskategori" x:Name="CategoryPicker"  Grid.Column="0"
                    ItemDisplayBinding="{Binding Name}" WidthRequest="70" HorizontalOptions="Start" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>

                    <Picker Title="Välj ursprungsland" x:Name="CountryPicker"  Grid.Column="1"
                        ItemDisplayBinding="{Binding Name}" WidthRequest="70" HorizontalOptions="Start" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>

                    <Picker Title="Betygsätt" x:Name="RemarkPicker" Grid.Column="2"
                        ItemDisplayBinding="{Binding Name}" WidthRequest="70" HorizontalTextAlignment="Start"/>
            </Grid>

                <Grid ColumnDefinitions="*,3*" ColumnSpacing="4" HorizontalOptions="Fill">

                    <Label Text="Beskrivning" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="End" Grid.Column="0"/>
                    <Editor  Grid.Column="1"
                        x:Name="BeverageDescriptionEntry"
                        Placeholder="Dryckens beskrivning"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120"
                        VerticalOptions="Fill" HorizontalOptions="Fill" VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>
                </Grid>
                <Grid ColumnDefinitions="4*" ColumnSpacing="4" HorizontalOptions="Fill">

                    <Image x:Name="CapturedPhotoImage" WidthRequest="300" HeightRequest="150" Grid.Column="0" />
                </Grid>

        <HorizontalStackLayout>
            <ImageButton Source="camera.png" Clicked="OnCapturePhotoClicked" SemanticProperties.Description="Ta foto" ToolTipProperties.Text="Ta foto" />
                    <ImageButton Source="save.png" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara dryck" ToolTipProperties.Text="Spara"/>
            <ImageButton Source="delete.png" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort dryck" ToolTipProperties.Text="Ta bort"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.png" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
