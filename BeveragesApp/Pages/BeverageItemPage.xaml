<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageItemPage">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
    <VerticalStackLayout>
            <HorizontalStackLayout>
                <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" />
            </HorizontalStackLayout>
            <Label Text="Dryck"
            SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Headline}"            
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>
        <Grid ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <Entry Grid.Row="0" Grid.Column="0" x:Name="BeverageIdEntry" Placeholder="Dryckens ID" IsEnabled="False" />
            <Entry Grid.Row="1" Grid.Column="0" x:Name="BeverageNameEntry" Placeholder="Dryckens namn" />
            <Entry Grid.Row="2" Grid.Column="0" x:Name="BeveragePriceEntry" Placeholder="Dryckens pris" />
            <Editor Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                    x:Name="BeverageDescriptionEntry"
                    Placeholder="Dryckens beskrivning"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="120"
                    VerticalOptions="Fill" />
        </Grid>
        <HorizontalStackLayout>
            <Picker Title="Välj dryckeskategori" x:Name="CategoryPicker"
                    ItemDisplayBinding="{Binding Name}" WidthRequest="70" />

            <Picker Title="Välj ursprungsland" x:Name="CountryPicker"
                ItemDisplayBinding="{Binding Name}" WidthRequest="70" />

            <Picker Title="Betygsätt" x:Name="RemarkPicker"
                ItemDisplayBinding="{Binding Name}" WidthRequest="70" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Image x:Name="CapturedPhotoImage" WidthRequest="300" HeightRequest="150" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <ImageButton Source="camera.svg" Clicked="OnCapturePhotoClicked" SemanticProperties.Description="Ta foto" ToolTipProperties.Text="Ta foto" WidthRequest="44" HeightRequest="44" />
            <ImageButton Source="save.svg" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara dryck" ToolTipProperties.Text="Spara" WidthRequest="44" HeightRequest="44" />
            <ImageButton Source="delete.svg" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort dryck" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.svg" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
