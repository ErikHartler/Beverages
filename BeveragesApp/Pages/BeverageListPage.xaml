<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageListPage">


    <ScrollView>
        <VerticalStackLayout Spacing="5"  VerticalOptions="Center">
            <Label Text="Drycker"
            SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="5">
                <Button Text="Lägg till" Clicked="OnAddBeverageClicked" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Beverages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto, Auto, Auto">
                            <Label Grid.Column="0"  
                                       x:Name="BeverageName"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                            <Label Grid.Column="1"  
                                       x:Name="BeverageCategory"
                                       Text="{Binding Category.Name}"
                                       VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Ändra" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="3" Text="Ta bort" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
