<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.BeverageListPage">


    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="5">
            <HorizontalStackLayout>
                <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" />
            </HorizontalStackLayout>
            <Label Text="Drycker"
            SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="5">
                <ImageButton Source="add.svg" Clicked="OnAddBeverageClicked" SemanticProperties.Description="Lägg till dryck" ToolTipProperties.Text="Lägg till dryck" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Beverages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto, Auto, Auto">
                            <Label Grid.Column="0"  
                                       x:Name="BeverageName"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                            <Label Grid.Column="1"  
                                       x:Name="BeverageCategory"
                                       Text="{Binding Category.Name}"
                                       VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="edit.svg" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ändra dryck" ToolTipProperties.Text="Ändra" WidthRequest="44" HeightRequest="44" />
                            <ImageButton Grid.Column="3" Source="delete.svg" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort dryck" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.svg" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
