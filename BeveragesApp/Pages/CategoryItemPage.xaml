<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.CategoryItemPage">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Arkiv">
            <MenuFlyoutItem
            Clicked="OnQuitClicked"
            Text="Avsluta" />
        </MenuBarItem>
        <MenuBarItem Text="Information">
            <MenuFlyoutItem Text="Drycker"/>
            <MenuFlyoutItem Text="Kategorier" />
            <MenuFlyoutItem Text="Länder" />
            <MenuFlyoutItem Text="Graderingar" />
        </MenuBarItem>
        <MenuBarItem Text="Visa">
            <MenuFlyoutItem Text="Uppdatera" />
            <MenuFlyoutItem Text="Toggle Light/Dark Mode" />
        </MenuBarItem>
        <MenuBarItem Text="Hjälp">
        </MenuBarItem>
    </ContentPage.MenuBarItems>
    
    <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="Dryckeskategori"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
        <Entry x:Name="CategoryIdEntry" Placeholder="Kategorins ID"  IsEnabled="False"  />
        <Entry x:Name="CategoryNameEntry" Placeholder="Kategorins namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <Button Grid.Column="2" Text="Uppdatera" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" />
            <Button Grid.Column="3" Text="Ta bort" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" />
        </VerticalStackLayout>

</ContentPage>
