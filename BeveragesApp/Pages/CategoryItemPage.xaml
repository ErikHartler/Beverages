<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.CategoryItemPage">

    <VerticalStackLayout Spacing="5"  VerticalOptions="Center">
            <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" />
            <Label Text="Dryckeskategori"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
        <Entry x:Name="CategoryIdEntry" Placeholder="Kategorins ID"  IsEnabled="False"  />
        <Entry x:Name="CategoryNameEntry" Placeholder="Kategorins namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <ImageButton Source="save.svg" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara kategori" ToolTipProperties.Text="Spara" WidthRequest="44" HeightRequest="44" />
        <ImageButton Source="delete.svg" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort kategori" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
        </VerticalStackLayout>

</ContentPage>
