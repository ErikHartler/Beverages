<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.CategoryItemPage">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
    <VerticalStackLayout Spacing="5">
            <HorizontalStackLayout>
                <ImageButton Source="back.png" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" />
            </HorizontalStackLayout>
            <Label Text="Dryckeskategori"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
        <Entry x:Name="CategoryIdEntry" Placeholder="Kategorins ID"  IsEnabled="False"  />
        <Entry x:Name="CategoryNameEntry" Placeholder="Kategorins namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <ImageButton Source="save.png" Clicked="OnUpdateBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara kategori" ToolTipProperties.Text="Spara" />
        <ImageButton Source="delete.png" Clicked="OnDeleteBeverageClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort kategori" ToolTipProperties.Text="Ta bort" />
        </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.png" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
