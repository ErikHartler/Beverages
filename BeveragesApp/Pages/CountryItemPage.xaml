<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.CountryItemPage">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
    <VerticalStackLayout Spacing="5">
            <HorizontalStackLayout>
                <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" />
            </HorizontalStackLayout>
            <Label Text="Land"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
        <Entry x:Name="CountryIdEntry" Placeholder="Landets ID"  IsEnabled="False"  />
        <Entry x:Name="CountryNameEntry" Placeholder="Landets namn"   />
 
        <Image Source="{Binding SelectedCountry.ImageSource}"  />    
        <ImageButton Source="save.svg" Clicked="OnUpdateCountryClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara land" ToolTipProperties.Text="Spara" WidthRequest="44" HeightRequest="44" />
        <ImageButton Source="delete.svg" Clicked="OnDeleteCountryClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort land" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
        </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.svg" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
