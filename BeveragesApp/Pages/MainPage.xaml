<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="0"  Padding="0,0" VerticalOptions="Center">
            <Label Text="Svenska kräftor kräfva dessa drycker"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>
            <ImageButton Source="beverages.svg" Clicked="OnShowBeveragesClicked"
                         SemanticProperties.Description="Drycker" ToolTipProperties.Text="Drycker"
                         WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" />
            <ImageButton Source="exit.svg" Clicked="OnQuitClicked"
                         SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta"
                         WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
