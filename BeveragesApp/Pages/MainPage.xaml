<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="Svenska kräftor kräfva dessa drycker"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" VerticalTextAlignment="Center"/>
            <Button Text="Drycker" Clicked="OnShowBeveragesClicked" />
            <Button Text="Avsluta" Clicked="OnQuitClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
