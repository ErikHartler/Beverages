<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.RemarkItemPage">

    <VerticalStackLayout Spacing="5"  VerticalOptions="Center">
            <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" />
            <Label Text="Gradering"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
        <Entry x:Name="RemarkIdEntry" Placeholder="Gradering ID"  IsEnabled="False"  />
        <Entry x:Name="RemarkOrderEntry" Placeholder="Graderingens ordningsnr"   />
        <Entry x:Name="RemarkTextEntry" Placeholder="Graderingens namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <ImageButton Source="save.svg" Clicked="OnUpdateRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara gradering" ToolTipProperties.Text="Spara" WidthRequest="44" HeightRequest="44" />
        <ImageButton Source="delete.svg" Clicked="OnDeleteRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort gradering" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
        </VerticalStackLayout>

</ContentPage>
