<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.RemarkItemPage">

    <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="Betyg"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
        <Entry x:Name="RemarkIdEntry" Placeholder="Betygs ID"  IsEnabled="False"  />
        <Entry x:Name="RemarkOrderEntry" Placeholder="Betygets ordningsnr"   />
        <Entry x:Name="RemarkTextEntry" Placeholder="Betygets namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <Button Grid.Column="2" Text="Uppdatera" Clicked="OnUpdateRemarkClicked" CommandParameter="{Binding .}" />
        <Button Grid.Column="3" Text="Ta bort" Clicked="OnDeleteRemarkClicked" CommandParameter="{Binding .}" />
        </VerticalStackLayout>

</ContentPage>
