<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.RemarkItemPage">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
    <VerticalStackLayout Spacing="5">
            <HorizontalStackLayout>
                <ImageButton Source="back.png" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" />
            </HorizontalStackLayout>
            <Label Text="Gradering"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
        <Entry x:Name="RemarkIdEntry" Placeholder="Gradering ID"  IsEnabled="False"  />
        <Entry x:Name="RemarkOrderEntry" Placeholder="Graderingens ordningsnr"   />
        <Entry x:Name="RemarkTextEntry" Placeholder="Graderingens namn"   />
 
        <Image Source="{Binding SelectedCategory.ImageSource}"  />    
        <ImageButton Source="save.png" Clicked="OnUpdateRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Spara gradering" ToolTipProperties.Text="Spara"  />
        <ImageButton Source="delete.png" Clicked="OnDeleteRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort gradering" ToolTipProperties.Text="Ta bort" />
        </VerticalStackLayout>
        </ScrollView>
        <ImageButton Grid.Row="1" Source="exit.png" Clicked="OnQuitClicked" SemanticProperties.Description="Avsluta" ToolTipProperties.Text="Avsluta" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" Margin="0,8,0,12" />
    </Grid>

</ContentPage>
