<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.RemarkListPage">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="Betyg"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="15">
                <Button Text="Lägg till" Clicked="OnAddRemarkClicked" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Remarks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto, Auto">
                            <Label Grid.Column="0"  
                                       x:Name="RemarkText"
                                       Text="{Binding Name}"
                                       FontSize="24"
                                       VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Ändra" Clicked="OnUpdateRemarkClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Ta bort" Clicked="OnDeleteRemarkClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
