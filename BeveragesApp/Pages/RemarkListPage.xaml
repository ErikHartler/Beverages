<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeveragesApp.RemarkListPage">
    <ScrollView>
        <VerticalStackLayout Spacing="5"  VerticalOptions="Center">
            <ImageButton Source="back.svg" Clicked="GoBack" SemanticProperties.Description="Tillbaka" ToolTipProperties.Text="Tillbaka" WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" />
            <Label Text="Graderingar"
            SemanticProperties.HeadingLevel="Level1"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="5">
                <ImageButton Source="add.svg" Clicked="OnAddRemarkClicked" SemanticProperties.Description="Lägg till gradering" ToolTipProperties.Text="Lägg till gradering" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Remarks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto, Auto">
                            <Label Grid.Column="0"  
                                       x:Name="RemarkText"
                                       Text="{Binding Name}"
                                       VerticalOptions="Center" />
                            <ImageButton Grid.Column="1" Source="edit.svg" Clicked="OnUpdateRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ändra gradering" ToolTipProperties.Text="Ändra" WidthRequest="44" HeightRequest="44" />
                            <ImageButton Grid.Column="2" Source="delete.svg" Clicked="OnDeleteRemarkClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Ta bort gradering" ToolTipProperties.Text="Ta bort" WidthRequest="44" HeightRequest="44" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
