<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DrinkManagement.MainPage">
<ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="Drink Management"
            SemanticProperties.HeadingLevel="Level1"
            FontSize="32"
            HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="15">
                <Label Text="Add a new drink" FontSize="18" />
                <Entry x:Name="DrinkNameEntry" Placeholder="Drink Name" />
                <Button Text="Add Drink" Clicked="OnAddDrinkClicked" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding Drinks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto, Auto">
                            <Entry Grid.Column="0"  
                                       x:Name="DrinkName"
                                       Text="{Binding Name}"
                                       FontSize="24"
                                       VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Update" Clicked="OnUpdateDrinkClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteDrinkClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
         </VerticalStackLayout>
</ScrollView>
</ContentPage>
